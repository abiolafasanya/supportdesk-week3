# Copy this file to .env and fill in YOUR OWN key. Never commit .env.
# Which provider to use: anthropic or openai
LLM_PROVIDER=anthropic

# Only the key for the provider you use is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Small, cheap models are plenty for ticket triage.
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-6-luna

# Hard cap on output tokens per call (cost guardrail).
MAX_OUTPUT_TOKENS=1024

# Week 3: which prompt file to use (prompts/triage/<version>.md)
PROMPT_VERSION=v2

# Week 3: native = provider structured outputs (JSON schema enforced by the API)
#         prompt = ask for JSON in the prompt and validate it ourselves (Week 2 style)
OUTPUT_MODE=native
